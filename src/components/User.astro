---
interface Props {
  texto: string;
  tipo?: 'text' | 'password';
}

const {
    texto, 
    tipo = 'text'
} = Astro.props;
---

<div class="user">
    <form action="iniciar" class="iniciar">
        <input type= {tipo} placeholder= {texto} class="texto">
    </form>
</div>

<style>
    
    .user{
        width: 30vw;
    }

    .user form{
        display: flex;
        flex-direction: column;
    }

    .texto{
        padding: 15px;
        margin-bottom: 20px;
        background-color: rgb(224, 224, 224);
        border-radius: 5px;
        border: 1px solid gray;
        font-size: 15px;
    }

</style>