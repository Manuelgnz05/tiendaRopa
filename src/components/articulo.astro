---
const { json } = Astro.props;
---

<article class="product-card">
    <div class="product-card__image-container">
        <img class="product-card__image" src={json.imagen} alt="Abrigo largo pliegue espalda">
    </div>
    <div class="product-card__info">
        <h2 class="product-card__title">{json.nombre}</h2>
        <p class="product-card__price">{json.precio}</p>
    </div>
</article>

<style>
    .product-card {
      width: 24%;
      display: flex;
      flex-direction: column;
    }

    .product-card__image-container {
      margin-bottom: 16px;
    }

    .product-card__image {
        display: block;
        width: 100%;
        height: auto; 
        object-fit: contain;
    }

    .product-card__info {
      text-align: center;
    }
    .product-card__title {
      font-size: 15px;
      font-weight: bold;
      color: #777777;
      margin-bottom: 6px;
      line-height: 20px;
    }
    .product-card__price {
      font-size: 16px;
      font-weight: bold;
      color: #333333;
    }

</style>